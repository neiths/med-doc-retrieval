# Environment variables for R2AI Medical Retrieval
# Copy this file to .env and customize as needed: cp .env.example .env

# Hugging Face token (if needed for gated models or rate limits)
HF_TOKEN=

# NCBI API Key (optional, allows up to 10 queries/sec instead of 3 queries/sec)
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# CUDA Device selection (e.g. 0, 1, or empty for default)
CUDA_VISIBLE_DEVICES=0
